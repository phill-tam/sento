VITE_API_BASE_URL=http://localhost:8000

# Shows the content-management UI. Access control, not a feature flag:
# the CMS drives write endpoints that have no authentication in front
# of them. Leave false anywhere reachable by anyone else. The backend
# must also set ADMIN_WRITES_ENABLED, or the page's requests will 404.
VITE_ADMIN_WRITES_ENABLED=false
