# App runtime — Supabase: use the transaction pooler (port 6543)
DATABASE_URL=postgresql+psycopg://sento:sento@localhost:5432/sento_db

# Migrations only — Supabase: use the direct connection (port 5432, non-pooler)
# Leave blank for local dev; falls back to DATABASE_URL automatically
MIGRATIONS_DATABASE_URL=

# Mounts the content-write endpoints (CSV upload, status PATCH). These
# have NO authentication — this switch is the only thing keeping them
# off a public deployment. Leave false unless you are the sole caller.
ADMIN_WRITES_ENABLED=False

# Sentence generator — selects the AI provider: development -> Gemini,
# production -> Claude
ENVIRONMENT=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
