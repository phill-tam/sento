# App runtime — Supabase: use the transaction pooler (port 6543)
DATABASE_URL=postgresql+psycopg://sento:sento@localhost:5432/sento_db

# Migrations only — Supabase: use the direct connection (port 5432, non-pooler)
# Leave blank for local dev; falls back to DATABASE_URL automatically
MIGRATIONS_DATABASE_URL=

# Tests only — a SEPARATE database from DATABASE_URL, not a separate user.
# The test fixtures roll back every write, which isolates writes but not
# reads: an aggregate query (the leaderboard's SUM ... GROUP BY, epic 016's
# global quota counter) still sees rows you created by using the app. Left
# blank this falls back to DATABASE_URL, which is what CI does — its
# Postgres is created empty per run — and which locally means the
# leaderboard tests fail against your own data.
#
# One-time local setup:
#   createdb sento_test    # or: psql -c 'CREATE DATABASE sento_test'
#   MIGRATIONS_DATABASE_URL=<the URL below> uv run alembic upgrade head
# Re-run the second command whenever a new migration lands.
TEST_DATABASE_URL=postgresql+psycopg://sento:sento@localhost:5432/sento_test

# Mounts the content-write endpoints (CSV upload, status PATCH). These
# have NO authentication — this switch is the only thing keeping them
# off a public deployment. Leave false unless you are the sole caller.
ADMIN_WRITES_ENABLED=False

# Mounts the sentence/folder persistence endpoints (save, list, relocate,
# delete, and all of /sentence-folders). Also unauthenticated. Saved
# sentences live in the user's browser as of epic 013, so the app does
# not call these — mounted, they are a shared pile any visitor can write
# into. Set True locally only to exercise the server path.
# POST /sentences/generate is NOT gated by this and stays available.
SENTENCE_PERSISTENCE_ENABLED=False

# AI provider — selects Gemini (development) or Claude (production) for
# BOTH the sentence generator and Word Pairs answer grading. The two
# features share this one switch and this one key per environment; there
# is no per-feature provider config (ADR 018).
ENVIRONMENT=development

# Required when ENVIRONMENT=development. Free-tier keys are rate-limited
# per minute as well as per day — sentence generation and answer grading
# now draw on the same quota, so heavy use of one can exhaust the other's
# headroom (ADR 018).
GEMINI_API_KEY=
# Change this if the pinned model is retired or capacity-constrained —
# it's a plain env var read at startup, never hardcoded in a code path
# (see DEFAULT_GEMINI_MODEL in app/config/settings.py for the fallback
# used only when this is left blank).
GEMINI_MODEL=gemini-3.5-flash

# Required when ENVIRONMENT=production.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
